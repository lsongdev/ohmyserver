go 1.26.1

// Local development: build against sibling checkouts of every module.
use (
	.
	../acme-go
	../docker-go
	../yabber
)

// Modules are not tagged yet; resolve them from the checkouts above.
replace (
	github.com/lsongdev/acme-go v0.0.0 => ../acme-go
	github.com/lsongdev/docker-go v0.0.0 => ../docker-go
	github.com/lsongdev/yabber v0.0.0 => ../yabber
)
