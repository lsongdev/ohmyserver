[Unit]
Description=OhMyServer panel
Documentation=https://github.com/lsongdev/ohmyserver
Wants=network-online.target
After=network-online.target

# Install:
#   install -m 755 ohmyserver /usr/local/bin/
#   install -m 644 contrib/systemd/ohmyserver.service /etc/systemd/system/
#   install -d -m 700 /var/lib/ohmyserver
#   install -m 600 config.yaml.example /var/lib/ohmyserver/config.yaml, then
#     edit it: keep listen on loopback, set a password and this machine's
#     host, e.g. password: <a long random secret>, host: 192.168.1.10
#   systemctl daemon-reload && systemctl enable --now ohmyserver
#
# The optional /etc/ohmyserver.env may hold OHMYSERVER_PASSWORD instead,
# which overrides the configuration's password.
#
# The panel listens on loopback; reach it through its own gateway (a site
# proxying to http://127.0.0.1:8080). The gateway's listeners (:80, :443 by
# default) and DNS listener only apply at the first start, after which they
# are edited in the panel. It runs as root: it manages packages, services,
# disks and files.

[Service]
Type=simple
EnvironmentFile=-/etc/ohmyserver.env
ExecStart=/usr/local/bin/ohmyserver -d /var/lib/ohmyserver
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
